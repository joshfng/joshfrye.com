#!/usr/bin/env bash

set -euo pipefail

if [ $# -lt 1 ] || [ -z "$1" ]; then
  echo "Usage: bin/tweet \"<tweet text>\" [--video <path>]"
  exit 1
fi

TWEET_TEXT="$1"
shift

VIDEO_PATH=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --video)
      VIDEO_PATH="$2"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1"
      exit 1
      ;;
  esac
done

# Navigate to project root
cd "$(dirname "$0")/.."

DATE=$(date +%Y-%m-%d)

# Generate URL-friendly slug from tweet text (up to ~8 words)
SLUG=$(echo "$TWEET_TEXT" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]/-/g' -e 's/-\+/-/g' -e 's/^-//' -e 's/-$//' | cut -d'-' -f1-8)

FILENAME="_tweets/${DATE}-${SLUG}.md"

# Ensure double quotes inside title are escaped for YAML
TITLE_ESCAPED=$(echo "$TWEET_TEXT" | sed 's/"/\\"/g')

VIDEO_TAG=""
DEST_VIDEO=""
DEST_IMAGE=""
FRONT_MATTER_VIDEO=""
if [ -n "$VIDEO_PATH" ]; then
  if [ ! -f "$VIDEO_PATH" ]; then
    echo "Error: Video file not found: $VIDEO_PATH"
    exit 1
  fi
  
  mkdir -p assets/videos
  
  if command -v ffmpeg >/dev/null 2>&1; then
    echo "Compressing and formatting video for web..."
    DEST_VIDEO="assets/videos/${DATE}-${SLUG}.mp4"
    ffmpeg -y -i "$VIDEO_PATH" -vcodec libx264 -crf 23 -preset medium -c:a aac -b:a 128k "$DEST_VIDEO" >/dev/null 2>&1

    echo "Generating poster image..."
    DEST_IMAGE=$(bin/poster "$DEST_VIDEO") || DEST_IMAGE=""

    if [ -n "$DEST_IMAGE" ] && [ -f "$DEST_IMAGE" ]; then
      FRONT_MATTER_VIDEO="video: /${DEST_VIDEO}
image: /${DEST_IMAGE}"
    else
      FRONT_MATTER_VIDEO="video: /${DEST_VIDEO}"
    fi
    VIDEO_TAG="

{% include tweet_video.html tweet=page %}"
  else
    echo "Warning: ffmpeg not found, copying video as-is."
    VIDEO_BASENAME=$(basename "$VIDEO_PATH")
    DEST_VIDEO="assets/videos/${DATE}-${SLUG}-${VIDEO_BASENAME}"
    cp "$VIDEO_PATH" "$DEST_VIDEO"
    FRONT_MATTER_VIDEO="video: /${DEST_VIDEO}"
    VIDEO_TAG="

{% include tweet_video.html tweet=page %}"
  fi
fi

cat <<EOF > "$FILENAME"
---
title: "${TITLE_ESCAPED}"
date: ${DATE}
${FRONT_MATTER_VIDEO}
---

${TWEET_TEXT}${VIDEO_TAG}
EOF

git add "$FILENAME"
if [ -n "$DEST_VIDEO" ]; then
  git add "$DEST_VIDEO"
fi
if [ -n "$DEST_IMAGE" ] && [ -f "$DEST_IMAGE" ]; then
  git add "$DEST_IMAGE"
fi

git commit -m "Tweet: ${TWEET_TEXT}"

echo "==> Tweet committed: ${FILENAME}"
echo "Run 'git push' when ready to deploy."
