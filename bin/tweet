#!/usr/bin/env bash

set -euo pipefail

if [ $# -lt 1 ] || [ -z "$1" ]; then
  echo "Usage: bin/tweet \"<tweet text>\""
  exit 1
fi

TWEET_TEXT="$1"

# Navigate to project root
cd "$(dirname "$0")/.."

DATE=$(date +%Y-%m-%d)

# Generate URL-friendly slug from tweet text (up to ~8 words)
SLUG=$(echo "$TWEET_TEXT" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]/-/g' -e 's/-\+/-/g' -e 's/^-//' -e 's/-$//' | cut -d'-' -f1-8)

FILENAME="_tweets/${DATE}-${SLUG}.md"

# Ensure double quotes inside title are escaped for YAML
TITLE_ESCAPED=$(echo "$TWEET_TEXT" | sed 's/"/\\"/g')

cat <<EOF > "$FILENAME"
---
title: "${TITLE_ESCAPED}"
date: ${DATE}
---

${TWEET_TEXT}
EOF

git add "$FILENAME"
git commit -m "Tweet: ${TWEET_TEXT}"

echo "==> Tweet committed: ${FILENAME}"
echo "Run 'git push' when ready to deploy."
